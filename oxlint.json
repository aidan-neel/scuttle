{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "target",
    "vendor/**",
    ".hutch",
    "apps/web/src/routeTree.gen.ts"
  ],
  "rules": {
    "no-console": "warn",
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  }
}
